// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TransactionType {
  DEPOT
  RETRAIT
  ACHAT
  PAIEMENT
  AJUSTEMENT
}
enum InvoiceStatus {
  BROUILLON   // facture en cours de création
  EN_ATTENTE  // créée mais pas encore payée
  PARTIEL     // avance
  PAYE        // totalement payé
  ANNULE      // annulée
}
enum PaymentMethod {
  CASH
  ORANGE_MONEY
  MOBILE_MONEY
  VIREMENT
}
enum PurchaseStatus {
  UNPAID
  PARTIAL
  PAID
}
model customer {
  id        String        @id @default(uuid())
  name      String
  phone     String?
  solde     Float    @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  transactions transaction[]

  invoices invoice[]
  payments      Payment[]

}

model transaction {
  id        String          @id @default(uuid())

  clientId  String ?
  customer   customer ?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId  String ? 
  account    Account ?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplierId  String ?
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  type      TransactionType
  amount    Float
  note      String?

  createdAt DateTime        @default(now())
  updatedAt DateTime      @updatedAt

}

model produit {
  id        String   @id @default(uuid())
  name      String
  price     Float
  purchasePrice Float?
  stock     Int      @default(0)

  invoiceItems InvoiceItem[]
    purchaseItems PurchaseItem[]

}
model invoice {
  id          String   @id @default(uuid())
  customerId  String
  customer    customer @relation(fields: [customerId], references: [id])

  total       Float    @default(0)
  status      InvoiceStatus @default(BROUILLON)
  paidAmount Float @default(0)
  remainingAmount Float @default(0)

  items       InvoiceItem[]
  payments      Payment[]


  createdAt   DateTime @default(now())
}

model InvoiceItem {
  id         String   @id @default(uuid())

  invoiceId  String
  invoice    invoice  @relation(fields: [invoiceId], references: [id])

  productId  String
  product    produit  @relation(fields: [productId], references: [id])

  quantity   Int
  price      Float
}
model Payment  {
  id            String   @id @default(uuid())
    customerId    String
  customer      customer @relation(fields: [customerId], references: [id])

  invoiceId     String?
  invoice       invoice ? @relation(fields: [invoiceId], references: [id])

  amount        Float

  method        PaymentMethod

  note          String?

  createdAt     DateTime @default(now())

}
model Purchase {
  id            String   @id @default(uuid())
  supplierId    String
  totalAmount   Float
  paidAmount    Float    @default(0)
  status        PurchaseStatus

  supplier      Supplier @relation(fields: [supplierId], references: [id])

  items         PurchaseItem[]

  createdAt     DateTime @default(now())
}
model Supplier {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  purchases   Purchase[]

  transactions transaction[]
}
model PurchaseItem {
  id            String   @id @default(uuid())

  purchaseId    String
  productId     String

  quantity      Int
  purchasePrice Float

  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  produit       produit  @relation(fields: [productId], references: [id])
}
model Account {
  id        String   @id @default(uuid())
  name      String   // Caisse, Orange Money, Banque
  balance   Float    @default(0)

  transactions transaction[]
}


